{
  "input": {
    "height": {
      "sm": {
        "$type": "dimension",
        "$value": "2rem"
      },
      "md": {
        "$type": "dimension",
        "$value": "2.5rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "3rem"
      }
    },
    "px": {
      "sm": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "md": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1rem"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "bg": {
      "$type": "color",
      "$value": "{color.bg.canvas}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "border-focus": {
      "$type": "color",
      "$value": "{color.border.focus}"
    }
  }
}