{
  "file-upload": {
    "background": {
      "$type": "color",
      "$value": "{color.bg.surface-sunken}"
    },
    "background-active": {
      "$type": "color",
      "$value": "{color.bg.canvas}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "border-active": {
      "$type": "color",
      "$value": "{color.border.focus}"
    },
    "border-radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.6}"
    }
  }
}