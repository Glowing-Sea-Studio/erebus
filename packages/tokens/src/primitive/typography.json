{
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "'Inter', ui-sans-serif, system-ui, sans-serif"
    },
    "heading": {
      "$type": "fontFamily",
      "$value": "'Montserrat', ui-sans-serif, system-ui, sans-serif"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
    }
  },
  "text": {
    "xs": {
      "fontSize": {
        "$type": "dimension",
        "$value": "0.75rem"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "1.5"
      }
    },
    "sm": {
      "fontSize": {
        "$type": "dimension",
        "$value": "0.875rem"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "1.5"
      }
    },
    "base": {
      "fontSize": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "1.5"
      }
    },
    "lg": {
      "fontSize": {
        "$type": "dimension",
        "$value": "1.125rem"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "1.5"
      }
    },
    "xl": {
      "fontSize": {
        "$type": "dimension",
        "$value": "1.25rem"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "1.5"
      }
    },
    "2xl": {
      "fontSize": {
        "$type": "dimension",
        "$value": "1.5rem"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "1.25"
      }
    },
    "3xl": {
      "fontSize": {
        "$type": "dimension",
        "$value": "1.875rem"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "1.25"
      }
    },
    "4xl": {
      "fontSize": {
        "$type": "dimension",
        "$value": "2.25rem"
      },
      "lineHeight": {
        "$type": "number",
        "$value": "1.2"
      }
    }
  },
  "weight": {
    "light": {
      "$type": "fontWeight",
      "$value": "300"
    },
    "normal": {
      "$type": "fontWeight",
      "$value": "400"
    },
    "medium": {
      "$type": "fontWeight",
      "$value": "500"
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": "600"
    },
    "bold": {
      "$type": "fontWeight",
      "$value": "700"
    },
    "extrabold": {
      "$type": "fontWeight",
      "$value": "800"
    },
    "black": {
      "$type": "fontWeight",
      "$value": "900"
    }
  }
}