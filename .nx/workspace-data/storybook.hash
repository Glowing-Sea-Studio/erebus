{
  "3362062273903579145": {
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "options": {
        "configDir": "packages/angular/.storybook",
        "browserTarget": "@glowing-sea-studio/erebus-angular:build-storybook",
        "compodoc": false,
        "outputDir": "packages/angular/storybook-static"
      },
      "cache": true,
      "outputs": [
        "{projectRoot}/storybook-static",
        "{options.output-dir}",
        "{options.outputDir}",
        "{options.o}"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "storybook",
            "@storybook/angular",
            "@storybook/test-runner"
          ]
        }
      ]
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "configDir": "packages/angular/.storybook",
        "browserTarget": "@glowing-sea-studio/erebus-angular:build-storybook",
        "compodoc": false
      }
    },
    "test-storybook": {
      "command": "test-storybook",
      "options": {
        "cwd": "packages/angular"
      },
      "inputs": [
        {
          "externalDependencies": [
            "storybook",
            "@storybook/test-runner"
          ]
        }
      ]
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "build-storybook",
        "staticFilePath": "packages/angular/storybook-static"
      }
    }
  },
